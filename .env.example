APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=change-me
DATABASE_PATH=./data/t_bookmarks.sqlite3
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
X_SCOPES=bookmark.read tweet.read users.read offline.access
SYNC_INTERVAL_MINUTES=360
REQUEST_TIMEOUT_SECONDS=30
LOG_DIR=./logs
LOG_LEVEL=INFO

# Cost controls (X API pay-per-use).
# MEASURED: only the bookmarked posts are billed ($0.001 each); author/media
# expansions are FREE. So the real cost lever is how many posts are read across
# UTC days -> keep the incremental page small and avoid needless full syncs.
# Small page for routine incremental polling keeps the "anything new?" check cheap.
INCREMENTAL_MAX_RESULTS=10
FULL_MAX_RESULTS=99
# Author expansion does NOT meaningfully affect cost (authors are free); this
# toggle only trims payload size. Leave true so search keeps author name/handle.
X_INCLUDE_AUTHOR_EXPANSION=true
# Local cost-estimate rates (USD/resource). VERIFY in the Developer Console.
# user-read rate is unused for bookmarks (expansion authors are not billed).
COST_OWNED_READ_USD=0.001
COST_USER_READ_USD=0.010
COST_POST_READ_USD=0.005
